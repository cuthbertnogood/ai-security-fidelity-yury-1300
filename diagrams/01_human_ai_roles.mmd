%% Человек: замысел, поручение, ответственность <-> ИИ: исполнение, верность
flowchart TB
    subgraph H["👤 Человек (принципал)"]
        direction TB
        H1["Замысел<br/><i>зачем и какой результат нужен</i>"]
        H2["Поручение<br/><i>что конкретно сделать</i>"]
        H3["Ответственность<br/><i>за конечный результат</i>"]
        H1 --> H2
    end

    subgraph A["🤖 ИИ-агент (исполнитель)"]
        direction TB
        A1["Исполнение<br/><i>рутинная работа, действия, вызовы инструментов</i>"]
        A2["Верность поручению и замыслу<br/><i>делает соразмерное, не выходит<br/>за разумные границы</i>"]
        A2 -. ограничивает .-> A1
    end

    subgraph G["🛡️ Контур гарантии (ИИ проверяет ИИ)"]
        direction TB
        G1["Проверка соответствия<br/>действий поручению"]
        G2["Обнаружение отклонений<br/>(prompt injection, утечки)"]
    end

    H2 -- "поручает" --> A1
    A1 -- "результат" --> H3
    A1 -- "телеметрия: запросы,<br/>прокси, системные вызовы" --> G1
    G1 --> G2
    G2 -- "сигнал / блок" --> A1
    G2 -- "отчёт и эскалация" --> H3
    H3 -. "принимает ответственность<br/>→ формулирует новое поручение" .-> H1
