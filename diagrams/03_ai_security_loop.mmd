%% Цикл «ИИ проверяет ИИ» + люди на полигоне (пример из выступления)
flowchart TB
    T["Искусственная задача:<br/>«построй инфраструктуру банка»"] --> B

    subgraph LOOP["Замкнутый цикл ИИ (повторяется с разными моделями:<br/>фронтирными, иностранными, отечественными, open source)"]
        direction LR
        B["ИИ-1 · Строитель<br/>строит виртуальный банк"]
        R["ИИ-2 · Атакующий<br/>через «дырочку» в инференсе<br/>подмешивает промпт"]
        D["ИИ-3 · Детектор<br/>собирает прокси, запросы,<br/>системные вызовы"]
        R -- "пытается заставить<br/>сделать опасное" --> B
        B -- "телеметрия" --> D
        D -- "обнаружение →<br/>улучшение защиты" --> B
        D -. "новые атаки" .-> R
    end

    LOOP --> P["Полигон для людей:<br/>белым хакерам дают ту же «дырочку»;<br/>если агент украдёт данные вместо<br/>постройки банка → награда 100 млн ₽"]
    P --> G["Итог: гарантия выполнения поручения<br/>+ финансовая ответственность разработчика"]
    G --> H["Человек несёт ответственность<br/>за конечный результат"]
