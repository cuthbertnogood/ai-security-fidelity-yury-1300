%% Старая модель безопасности против новой (по выступлению Ю. Максимова)
flowchart LR
    subgraph OLD["Старая модель: безопасность через запреты"]
        direction TB
        O1["Список «нельзя»:<br/>это нельзя, это и это"] --> O2["Периметр, ACL, политики,<br/>требования к пользователю"]
        O2 --> O3["Цель: CIA<br/>конфиденциальность · целостность · доступность"]
        O3 --> O4["Побочный эффект:<br/>качество работы снижается,<br/>безопасность «не появляется»"]
        O4 --> O5["С ИИ-агентом: агент «начинает тупить»<br/>и не делает свою работу"]
    end

    subgraph NEW["Новая модель: безопасность как верность поручению"]
        direction TB
        N1["Поручение и замысел человека"] --> N2["Агент делает соразмерное поручению<br/>и не выходит за разумные границы"]
        N2 --> N3["Контроль силами ИИ:<br/>строитель · атакующий · детектор"]
        N3 --> N4["Проверка людьми: полигон<br/>и вознаграждение белым хакерам"]
        N4 --> N5["Гарантия: разработчик несёт<br/>финансовую ответственность за результат"]
        N5 --> N6["Безопасность становится удобной;<br/>ответственность за итог несёт человек"]
    end

    OLD == "сдвиг парадигмы" ==> NEW
